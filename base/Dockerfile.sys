FROM debian:trixie-slim
LABEL maintainer="Chris Isler <christopherisler1@gmail.com>"
ENV TERM=xterm-256color

ARG GO_VERSION=1.26.2
ARG TARGETARCH

RUN apt-get update && \
      apt-get install --assume-yes --quiet --no-install-recommends git tmux \
      wget curl man ca-certificates sudo build-essential tree locales less gh vim \
      gpg gpg-agent ssh file bash-completion xclip python3-pip python3-setuptools tig

RUN set -eux; \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) go_arch=amd64 ;; \
      arm64) go_arch=arm64 ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    go_archive="go${GO_VERSION}.linux-${go_arch}.tar.gz"; \
    curl --fail --silent --show-error --location "https://go.dev/dl/${go_archive}" --output "/tmp/${go_archive}"; \
    curl --fail --silent --show-error --location "https://go.dev/dl/${go_archive}.sha256" --output "/tmp/${go_archive}.sha256"; \
    test "$(sha256sum "/tmp/${go_archive}" | cut -d " " -f 1)" = "$(tr -d "[:space:]" < "/tmp/${go_archive}.sha256")"; \
    tar --extract --gzip --file "/tmp/${go_archive}" --directory /usr/local; \
    rm --force "/tmp/${go_archive}" "/tmp/${go_archive}.sha256"

ENV PATH="/usr/local/go/bin:${PATH}"

RUN group_name="$(getent group 1000 | cut --delimiter=: --fields=1)" && \
      if [ -z "${group_name}" ]; then \
        groupadd --gid 1000 devuser; \
        group_name=devuser; \
      fi && \
      user_name="$(getent passwd 1000 | cut --delimiter=: --fields=1)" && \
      if [ -n "${user_name}" ]; then \
        [ "${user_name}" = devuser ] || usermod --login devuser \
          --home /home/devuser --move-home "${user_name}"; \
      else \
        useradd --uid 1000 --gid "${group_name}" --shell /bin/bash \
          --create-home devuser; \
      fi && \
      chgrp --recursive 1000 /usr/local && \
      find /usr/local -type d | xargs chmod g+w && \
      printf "devuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/devuser && \
      chmod 0440 /etc/sudoers.d/devuser

RUN printf "[user]\nname = Chris I\nemail = isl.chr@proton.me" > ~/.gitconfig

RUN sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen && \
      locale-gen en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
