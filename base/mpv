FROM debian:trixie-slim
RUN apt-get update && \
    apt-get install --assume-yes --quiet --no-install-recommends \
    mpv pulseaudio-utils libasound2-plugins && \
    rm -rf /var/lib/apt/lists/*
COPY mpv-audio-switch.lua /usr/share/mpv/scripts/mpv-audio-switch.lua
ENTRYPOINT ["mpv", "--profile=fast", "--vo=x11", "--keepaspect-window=no", "--video-sync=audio", "--interpolation=no", "--ao=pulse", "--framedrop=vo", "--script=/usr/share/mpv/scripts/mpv-audio-switch.lua", "--shuffle", "--loop-file=inf"]
