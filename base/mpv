# syntax=docker/dockerfile:1

FROM debian:trixie-slim
RUN apt-get update && \
    apt-get install --assume-yes --quiet --no-install-recommends \
    mpv pulseaudio-utils libasound2-plugins && \
    rm -rf /var/lib/apt/lists/*
COPY mpv-audio-switch.lua /usr/share/mpv/scripts/mpv-audio-switch.lua
ENTRYPOINT ["mpv", "--vo=x11", "--ao=pulse", "--script=/usr/share/mpv/scripts/mpv-audio-switch.lua", "--shuffle", "--loop-file=inf"]
