# syntax=docker/dockerfile:1

# Minimal tdf (terminal PDF viewer) image: alpine build + run.
FROM alpine:3.21 AS build
RUN apk add --no-cache build-base pkgconfig fontconfig-dev curl && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh && \
    sh /tmp/rustup.sh -y --profile minimal --no-modify-path && \
    rm -f /tmp/rustup.sh && \
    /root/.cargo/bin/cargo install --root /out \
        --git https://github.com/itsjunetime/tdf.git --locked && \
    test -x /out/bin/tdf

FROM alpine:3.21
RUN apk add --no-cache fontconfig
COPY --from=build /out/bin/tdf /usr/local/bin/tdf
ENTRYPOINT ["tdf"]