# syntax=docker/dockerfile:1

# TermPDF-rs PDF viewer image. The upstream PDFium bundle is x86_64-only.
FROM --platform=linux/amd64 debian:trixie-slim AS build
RUN apt-get update && \
    apt-get install --assume-yes --quiet --no-install-recommends \
    build-essential pkg-config libfontconfig1-dev curl ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh && \
    sh /tmp/rustup.sh -y --profile minimal --no-modify-path && \
    rm --force /tmp/rustup.sh

RUN git init --quiet /tmp/termpdf-rs && \
    git -C /tmp/termpdf-rs remote add origin https://github.com/amanagr/termpdf-rs.git && \
    git -C /tmp/termpdf-rs fetch --quiet --depth 1 origin 6421295741bb8ccb76c7ebb0a9c3bad690a3bdc8 && \
    git -C /tmp/termpdf-rs checkout --quiet --detach FETCH_HEAD && \
    cd /tmp/termpdf-rs && \
    ./setup.sh && \
    /root/.cargo/bin/cargo build --release --locked && \
    install --directory /out/bin && \
    install target/release/termpdf /out/bin/termpdf && \
    install vendor/libpdfium.so /out/bin/libpdfium.so

FROM --platform=linux/amd64 debian:trixie-slim
RUN apt-get update && \
    apt-get install --assume-yes --quiet --no-install-recommends \
    fontconfig libstdc++6 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /out/bin/termpdf /usr/local/bin/termpdf
COPY --from=build /out/bin/libpdfium.so /usr/local/lib/libpdfium.so
ENV TERMPDF_PDFIUM=/usr/local/lib/libpdfium.so
ENTRYPOINT ["termpdf"]
