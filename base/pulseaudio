# syntax=docker/dockerfile:1

FROM debian:trixie-slim
RUN apt-get update && \
    apt-get install --assume-yes --quiet --no-install-recommends \
    pulseaudio && \
    rm -rf /var/lib/apt/lists/*
EXPOSE 4713/tcp
ENTRYPOINT ["pulseaudio"]
CMD ["--system", "--disallow-exit", "--exit-idle-time=-1", "--load=module-native-protocol-tcp auth-anonymous=1 port=4713", "--load=module-null-sink sink_name=virtual"]
