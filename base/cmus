# syntax=docker/dockerfile:1

FROM debian:trixie-slim
RUN apt-get update && \
    apt-get install --assume-yes --quiet --no-install-recommends \
    cmus cmus-plugin-ffmpeg pulseaudio-utils libasound2-plugins && \
    rm -rf /var/lib/apt/lists/*
# ponytail: no D-Bus session bus in container; disable MPRIS to skip startup error prompt (upstream: :set mpris=false).
RUN mkdir -p /root/.config/cmus && \
    printf 'set mpris=false\nset output_plugin=pulse\n' > /root/.config/cmus/rc
ENTRYPOINT ["cmus"]
