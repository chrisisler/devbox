# echo 'source ~/devbox/.dockerfunc' >> ~/.bashrc
#
DOCKER_REPO_PREFIX=${DOCKER_REPO_PREFIX:-chrisisler}

dcleanup(){
	local containers
	mapfile -t containers < <(docker ps -aq 2>/dev/null)
	docker rm "${containers[@]}" 2>/dev/null
	local volumes
	mapfile -t volumes < <(docker ps --filter status=exited -q 2>/dev/null)
	docker rm -v "${volumes[@]}" 2>/dev/null
	local images
	mapfile -t images < <(docker images --filter dangling=true -q 2>/dev/null)
	docker rmi "${images[@]}" 2>/dev/null
	mapfile -t images < <(docker images -q 2>/dev/null)
	docker rmi "${images[@]}" 2>/dev/null
	docker system prune -f
}
del_stopped() {
  local name="$1"
  local state
  state="$(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null)" || return 0
  if [[ "$state" == "false" ]]; then
    docker rm "$name"
  fi
}

relies_on() {
  local container state
  for container in "$@"; do
    state="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null)"
    if [[ "$state" != "true" ]]; then
      printf '%s is not running, starting it for you.\n' "$container"
      "$container"
    fi
  done
}

_container_file() {
  local image="$1" container="$2" file="$3"
  shift 3
  local host_file host_dir filename
  local tmux_env=()
  if [[ "$file" == shared/* ]]; then
    host_file="$HOME/Desktop/devbox/shared/${file#shared/}"
  else
    host_file="$file"
  fi
  if [[ "$host_file" == *[\*\?\[]* ]]; then
    host_file="${host_file%/*}"
  fi
  host_dir="${host_file%/*}"
  filename="${host_file##*/}"
  if [[ ! -e "$host_file" ]]; then
    printf '%s: file not found: %s\n' "$container" "$host_file" >&2
    return 1
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux_env=(--env "TMUX=$TMUX")
  fi
  docker run -it --rm --init \
    --log-driver none \
    --env TERM="${TERM:-xterm-256color}" \
    --env TERM_PROGRAM="${TERM_PROGRAM:-ghostty}" \
    "${tmux_env[@]}" \
    "$@" \
    --volume "$host_dir:/home/pdf:ro" \
    "$image" \
    "/home/pdf/$filename"
}

tdf() {
  local file="${1:?usage: tdf <docker-shared file in shared/ or absolute host path>}"
  if [[ -n "$(type -P tdf)" ]]; then
    tdf "$@"
  else
    _container_file chrisisler/tdf tdf "$file"
  fi
}

termpdf() {
  local file="${1:?usage: termpdf <docker-shared file in shared/ or absolute host path>}"
  if [[ -n "$(type -P termpdf)" ]]; then
    termpdf "$@"
  else
    _container_file chrisisler/termpdf termpdf "$file"
  fi
}

mpv() {
  local file="${1:?usage: mpv <media file>}"
  if [[ -n "$(type -P mpv)" ]]; then
    command mpv --shuffle --loop-file=inf "$@"
  else
    _container_file chrisisler/mpv mpv "$file" \
      --env DISPLAY=host.docker.internal:0 \
      --env PULSE_SERVER=tcp:host.docker.internal:4713
  fi
}

cmus() {
  if [[ -n "$(type -P cmus)" ]]; then
    command cmus "$@"
  elif [[ $# -gt 0 ]]; then
    _container_file chrisisler/cmus cmus "$1" \
      --env PULSE_SERVER=tcp:host.docker.internal:4713
  else
    # ponytail: ephemeral ~/.cmus library, no music mount; upgrade path = named volume + dir mount when persistence needed.
    docker run -it --rm --init \
      --log-driver none \
      --env TERM="${TERM:-xterm-256color}" \
      --env PULSE_SERVER=tcp:host.docker.internal:4713 \
      --volume "$HOME/repos/shared/allmusic:/media:ro" \
      chrisisler/cmus
  fi
}

cpianobar() {
  # if [[ -n "$(type -P pianobar)" ]]; then
  #   command pianobar "$@"
  # else
    if [[ ! -f "$HOME/repos/devbox/pandora-password" ]]; then
      printf 'pianobar: expected password file at %s\n' \
        "$HOME/repos/devbox/pandora-password" >&2
      return 1
    fi
    local proxy_args=()
    if [[ -n "${PANDORA_PROXY:-}" ]]; then
      if [[ ! -f "$HOME/repos/devbox/mitmproxy-ca.pem" ]]; then
        printf 'cpianobar: expected proxy CA at %s\n' \
          "$HOME/repos/devbox/mitmproxy-ca.pem" >&2
        return 1
      fi
      proxy_args=(
        --env "PANDORA_PROXY=$PANDORA_PROXY"
        --env PANDORA_CA_BUNDLE=/mitmproxy-ca.pem
        --volume "$HOME/repos/devbox/mitmproxy-ca.pem:/mitmproxy-ca.pem:ro"
      )
    fi
    docker run -it --rm --init \
      --network host \
      --log-driver none \
      --env TERM="${TERM:-xterm-256color}" \
      --env PULSE_SERVER=tcp:host.docker.internal:4713 \
      --env EMAIL="${PIANOBAR_EMAIL:-4444cisler4444@gmail.com}" \
      --volume "$HOME/repos/devbox/pandora-password:/password:ro" \
      "${proxy_args[@]}" \
      chrisisler/pianobar
  # fi
}
