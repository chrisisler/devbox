# dockerized host tools: source this from ~/.bashrc
#   echo 'source ~/devbox/.dockerfunc' >> ~/.bashrc
# Runs toolbox containers instead of installing on the host.

DOCKER_REPO_PREFIX=${DOCKER_REPO_PREFIX:-chrisisler}
PDF_IMAGE=${PDF_IMAGE:-${DOCKER_REPO_PREFIX}/devbox-tdf}

pdf() {
  local file="${1:?usage: pdf <file in shared/ or absolute host path>}"
  if [[ -n "$(command -v tdf)" ]]; then
    tdf "$@"
  else
    docker run -it --rm --init \
      --log-driver none \
      --name tdf \
      --volume "$HOME/Desktop/devbox/shared:/home/devuser/shared:ro" \
      "$PDF_IMAGE" \
      tdf "/home/devuser/shared/${file#"$HOME"/Desktop/devbox/shared/}"
  fi
}