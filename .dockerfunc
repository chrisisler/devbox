# echo 'source ~/devbox/.dockerfunc' >> ~/.bashrc
#
DOCKER_REPO_PREFIX=${DOCKER_REPO_PREFIX:-chrisisler}

del_stopped() {
  local name="$1"
  local state
  state="$(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null)" || return 0
  if [[ "$state" == "false" ]]; then
    docker rm "$name"
  fi
}

_container_pdf() {
  local viewer="$1" image="$2" container="$3" file="$4"
  local host_file host_dir filename
  local tmux_env=()
  if [[ "$file" == shared/* ]]; then
    host_file="$HOME/Desktop/devbox/shared/${file#shared/}"
  else
    host_file="$file"
  fi
  host_dir="${host_file%/*}"
  filename="${host_file##*/}"
  if [[ ! -f "$host_file" ]]; then
    printf '%s: file not found: %s\n' "$viewer" "$host_file" >&2
    return 1
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux_env=(--env "TMUX=$TMUX")
  fi
  del_stopped "$container"
  docker run -it --rm --init \
    --log-driver none \
    --name "$container" \
    --env TERM="${TERM:-xterm-256color}" \
    --env TERM_PROGRAM="${TERM_PROGRAM:-ghostty}" \
    "${tmux_env[@]}" \
    --volume "$host_dir:/home/devuser/pdf:ro" \
    "$image" \
    "/home/devuser/pdf/$filename"
}

ctdf() {
  local file="${1:?usage: ctdf <file in shared/ or absolute host path>}"
  if [[ -n "$(command -v tdf)" ]]; then
    tdf "$@"
  else
    _container_pdf ctdf chrisisler/tdf ctdf "$file"
  fi
}

ctermpdf() {
  local file="${1:?usage: ctermpdf <file in shared/ or absolute host path>}"
  if [[ -n "$(command -v termpdf)" ]]; then
    termpdf "$@"
  else
    _container_pdf ctermpdf chrisisler/termpdf ctermpdf "$file"
  fi
}
